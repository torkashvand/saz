# Database Configuration
DATABASE_URL=sqlite:///./saz.db

# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your-key-here
LLM_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-4o
CRITIC_MODEL=gpt-4o

# Security: Credentials Encryption
CREDENTIALS_ENCRYPTION_KEY=your-encryption-key-here

# Security: Stack Trace Exposure Control
# WARNING: Should ALWAYS be False in production
# Only set to True in development/staging for debugging
# When False, stack traces are NEVER exposed via API, even if ?include_sensitive=true is requested
# When True, stack traces can be exposed via API with ?include_sensitive=true parameter
ALLOW_SENSITIVE_DATA=false

# Authentication: JWT signing
# REQUIRED. Generate a strong random value (32+ bytes). Examples:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leaving this blank causes /api/v1/auth/login to fail closed — the
# server will refuse to mint or accept access tokens.
JWT_SECRET_KEY=
# JWT signing algorithm. HS256 is the default; change only with care.
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes. There are no refresh tokens, so the
# user must log in again after this expires.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# There is no public registration and no forgot-password flow. The
# only ways to create or recover an account are:
#   1. The saz.scripts.create_user CLI (for the first admin)
#   2. The authenticated admin user-management API (/api/v1/admin/users)
# If a user forgets their password, an admin resets it from the admin
# panel; the user is then forced to pick a new one on next login.
