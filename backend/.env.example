# Database Configuration
# Saz is PostgreSQL-only (no SQLite fallback). Point this at your cluster.
DATABASE_URL=postgresql+psycopg2://saz:saz@localhost:5432/saz_db

# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your-key-here
LLM_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-4o
CRITIC_MODEL=gpt-4o

# Security: Credentials Encryption
CREDENTIALS_ENCRYPTION_KEY=your-encryption-key-here

# Security: Stack Trace Exposure Control
# WARNING: Should ALWAYS be False in production
# Only set to True in development/staging for debugging
# When False, stack traces are NEVER exposed via API, even if ?include_sensitive=true is requested
# When True, stack traces can be exposed via API with ?include_sensitive=true parameter
ALLOW_SENSITIVE_DATA=false

# Authentication: JWT signing
# REQUIRED. Generate a strong random value (32+ bytes). Examples:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leaving this blank causes /api/v1/auth/login to fail closed — the
# server will refuse to mint or accept access tokens.
JWT_SECRET_KEY=
# JWT signing algorithm. HS256 is the default; change only with care.
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes. A rotating HttpOnly refresh-session
# cookie (below) keeps the session alive past this without re-login.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Refresh sessions (server-side, revocable). The access token carries a
# session id checked on every request, so revocation is immediate.
REFRESH_COOKIE_NAME=saz_refresh
SESSION_IDLE_TIMEOUT_DAYS=7
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
# Set COOKIE_SECURE=true behind HTTPS. SameSite: lax | strict | none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Public base URLs, used to build the OIDC redirect URI and post-login
# redirects. Set these to your real hostnames in a deployment.
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# CORS: browser origins allowed to call the API. Comma-separated.
# Shared by the CORS middleware AND the exception-handler responses,
# so a misconfigured value here also hides server errors behind the
# misleading "Connection issue" UI message.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# There is no public registration and no forgot-password flow. Accounts
# are created by:
#   1. The saz.scripts.create_user CLI (for the first admin)
#   2. The authenticated admin user-management API (/api/v1/admin/users)
#   3. OIDC SSO just-in-time provisioning, when enabled on a provider
#      (Admin -> SSO), at a configurable default role (never admin).
# If a user forgets their password, an admin resets it from the admin
# panel; the user is then forced to pick a new one on next login.
